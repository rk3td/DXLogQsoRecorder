<Window x:Class="DXLogQsoRecorder.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Icon="AppIcon.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Padding="28,24,28,22">
        <StackPanel>
            <Image Source="AppIcon.png" Width="104" Height="104" HorizontalAlignment="Center"/>

            <TextBlock Text="DXLog QSO Recorder"
                       Margin="0,14,0,0"
                       FontSize="22" FontWeight="SemiBold"
                       TextAlignment="Center"/>
            <TextBlock Text="Version 1.2.4"
                       Margin="0,5,0,0"
                       TextAlignment="Center"/>

            <Separator Margin="32,18,32,16"/>

            <TextBlock Text="Author: Sergey Zimin"
                       TextAlignment="Center"/>
            <TextBlock Text="Callsign: RK3TD"
                       Margin="0,3,0,0"
                       TextAlignment="Center"/>
            <TextBlock Text="Developed for DXLog.net"
                       Margin="0,12,0,0"
                       TextAlignment="Center"/>
            <TextBlock Text="© 2026 Sergey Zimin"
                       Margin="0,10,0,0"
                       TextAlignment="Center"/>

            <Button Content="Close"
                    Width="100" Height="32"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Center"
                    IsDefault="True" IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Border>
</Window>
