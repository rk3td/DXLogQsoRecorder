<Window x:Class="DXLogQsoRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXLog QSO Recorder v1.1.0 by RK3TD" Icon="AppIcon.ico"
        Height="720" Width="1040" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="AppIcon.png" Width="36" Height="36" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="DXLog QSO Recorder" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="v1.1.0 by RK3TD" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
            <Button Content="About" Width="110" Height="30" DockPanel.Dock="Right" Click="AboutButton_Click"/>
        </DockPanel>

        <GroupBox Header="DXLog UDP" Grid.Row="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bind address:" VerticalAlignment="Center"/>
                <TextBox x:Name="BindAddressBox" Grid.Column="1" Margin="8,0"/>
                <TextBlock Grid.Column="3" Text="UDP port:" VerticalAlignment="Center"/>
                <TextBox x:Name="UdpPortBox" Grid.Column="4" Margin="8,0"/>
                <TextBlock x:Name="UdpStatusText" Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Stopped"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Audio" Grid.Row="2" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="95"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Device:" VerticalAlignment="Center"/>
                <ComboBox x:Name="AudioDeviceCombo" Grid.Column="1" Margin="8,0,16,0" DisplayMemberPath="Name"/>
                <TextBlock Grid.Column="2" Text="Before QSO, sec:" VerticalAlignment="Center"/>
                <TextBox x:Name="PreBufferBox" Grid.Column="3" Margin="8,0,16,0"/>
                <TextBlock Grid.Column="4" Text="After QSO, sec:" VerticalAlignment="Center"/>
                <TextBox x:Name="PostBufferBox" Grid.Column="5" Margin="8,0,16,0"/>
                <TextBlock Grid.Column="6" Text="MP3, kbps:" VerticalAlignment="Center"/>
                <ComboBox x:Name="BitrateCombo" Grid.Column="7" Margin="8,0,0,0" SelectedIndex="1">
                    <ComboBoxItem Content="32"/><ComboBoxItem Content="48"/><ComboBoxItem Content="64"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Recording directory (relative to the application folder or an absolute path):"/>
                <TextBox x:Name="OutputDirectoryBox" Margin="0,4,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Level:" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="LevelBar" Grid.Column="1" Height="18" Margin="8,0,16,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="CurrentQsoText" Grid.Column="2" VerticalAlignment="Center" Text="Waiting for QSO"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                <Button x:Name="StartButton" Content="Start" Width="110" Height="34" Margin="0,0,8,0" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="110" Height="34" IsEnabled="False" Click="StopButton_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="RecordingsGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat=HH:mm:ss}" Width="90"/>
                <DataGridTextColumn Header="Callsign" Binding="{Binding Call}" Width="130"/>
                <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="90"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="5" Margin="0,10,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
