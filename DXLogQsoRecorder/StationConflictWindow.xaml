<Window x:Class="DXLogQsoRecorder.StationConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXLog station detected"
        Width="780" MinWidth="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="A QSO from another DXLog station was detected."
                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <TextBlock x:Name="StationInfoText" Grid.Row="1" Margin="0,14,0,0"
                   FontSize="14" TextWrapping="Wrap"/>

        <TextBlock x:Name="CountdownText" Grid.Row="2" Margin="0,12,0,0"
                   Foreground="DimGray" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="The selected option applies until Stop is pressed. If no choice is made, the current station remains unchanged and this warning closes automatically."/>

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Margin="0,0,8,0" MinHeight="52" Padding="10,6"
                    IsDefault="True" Click="KeepCurrent_Click">
                <TextBlock Text="Keep current station" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>

            <Button x:Name="SwitchButton" Grid.Column="1" Margin="4,0" MinHeight="52" Padding="10,6"
                    Click="Switch_Click">
                <TextBlock x:Name="SwitchButtonText" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>

            <Button Grid.Column="2" Margin="8,0,0,0" MinHeight="52" Padding="10,6"
                    Click="RecordAll_Click">
                <TextBlock Text="Record all stations" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
        </Grid>
    </Grid>
</Window>
